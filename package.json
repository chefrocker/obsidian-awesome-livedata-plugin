{
  "name": "obsidian-live-data-hub",
  "version": "2.0.0",
  "description": "Display live MQTT and REST API data directly in Obsidian notes.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "version": "node version-bump.mjs && git add manifest.json versions.json"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "mqtt",
    "rest",
    "iot",
    "live-data",
    "dashboard"
  ],
  "author": "Sandro Ballarini",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "esbuild": "0.19.8",
    "eslint": "^8.57.1",
    "obsidian": "latest",
    "tslib": "2.6.2",
    "typescript": "5.3.2"
  },
  "dependencies": {
    "mqtt": "5.14.1"
  }
}
